# Usar la imagen oficial ligera de Node.js 20
FROM node:20-alpine

# Definir el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiar archivos de gestión de paquetes e instalar dependencias
COPY package*.json ./
RUN npm install

# Copiar el resto del código fuente del frontend
COPY . .

# Exponer el puerto por defecto de Vite
EXPOSE 3000

# Comando para ejecutar el servidor de desarrollo de Vite
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]